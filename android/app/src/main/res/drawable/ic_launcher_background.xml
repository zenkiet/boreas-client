<?xml version="1.0" encoding="utf-8"?>
<!--
  Boreas launcher background.

  The colour ramp is sampled from the iOS Icon Composer icon (ios/App/App/AppIcon.icon), whose
  automatic gradient runs from a flat plateau at the top to a flat #0088FF below 67.5%.

  The gradient axis spans y=18..90, i.e. the visible 72dp face of the 108dp adaptive layer — NOT
  the full layer. Anchoring it to 0..108 would push the light plateau above the mask edge, where
  it would never be seen. tileMode="clamp" carries the end colours across the 18dp bleed.

  Deliberately flat: no rim light, vignette, inner stroke or corner radius. The OEM mask shape is
  unknown and user-changeable, so any effect keyed to a boundary would be sliced by the wrong shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#FF47A8FF" />
                <item android:offset="0.1" android:color="#FF47A7FF" />
                <item android:offset="0.4" android:color="#FF2096FF" />
                <item android:offset="0.675" android:color="#FF0088FF" />
                <item android:offset="1" android:color="#FF0088FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
