{
  "path": ["src"],
  "format": ["typescript", "css", "markup"],
  "threshold": 1.5,
  "minTokens": 60,
  "minLines": 5,
  "mode": "weak",
  "ignore": ["**/*.spec.ts", "**/*.dto.ts", "**/*.mapper.ts"],
  "ignoreCase": false,
  "absolute": false,
  "gitignore": true,
  "reporters": ["console", "html"],
  "output": "reports/jscpd"
}
