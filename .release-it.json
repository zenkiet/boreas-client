{
  "git": {
    "requireCleanWorkingDir": true,
    "commitMessage": "chore: 🔖 bump version ${version}",
    "tagName": "v${version}",
    "push": false,
    "pushRepo": "origin"
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": true,
    "draft": false,
    "preRelease": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:bump": ["echo '✅ Version bumped successfully'"]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md"
    }
  }
}
